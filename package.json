{
    "name": "obrio-backend-test",
    "version": "1.0.0",
    "description": "Microservices-based user management with scheduled push notifications",
    "author": "",
    "private": true,
    "license": "MIT",
    "scripts": {
        "build": "nest build",
        "build:gateway": "nest build api-gateway",
        "build:user": "nest build user-service",
        "build:notification": "nest build notification-service",
        "start:gateway:dev": "nest start api-gateway --watch",
        "start:user:dev": "nest start user-service --watch",
        "start:notification:dev": "nest start notification-service --watch",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:migrate:deploy": "prisma migrate deploy",
        "prisma:studio": "prisma studio",
        "format": "prettier --write \"apps/**/*.ts\" \"shared/**/*.ts\"",
        "format:check": "prettier --check \"apps/**/*.ts\" \"shared/**/*.ts\"",
        "lint": "eslint \"{apps,shared}/**/*.ts\" --fix",
        "lint:check": "eslint \"{apps,shared}/**/*.ts\""
    },
    "dependencies": {
        "@fastify/static": "^8.3.0",
        "@fastify/view": "^11.1.1",
        "@nestjs/common": "^11.1.8",
        "@nestjs/config": "^4.0.2",
        "@nestjs/core": "^11.1.8",
        "@nestjs/microservices": "^11.1.8",
        "@nestjs/platform-fastify": "^11.1.8",
        "@nestjs/swagger": "^11.2.1",
        "@prisma/client": "^6.19.0",
        "amqp-connection-manager": "^5.0.0",
        "amqplib": "^0.10.9",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.2",
        "joi": "^18.0.1",
        "nestjs-pino": "^4.4.1",
        "pino-http": "^10.5.0",
        "pino-pretty": "^13.1.2",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2"
    },
    "devDependencies": {
        "@nestjs/cli": "^11.0.10",
        "@types/amqplib": "^0.10.8",
        "@types/node": "^24.10.0",
        "@typescript-eslint/eslint-plugin": "^7.18.0",
        "@typescript-eslint/parser": "^7.18.0",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.2.1",
        "prettier": "^3.4.1",
        "prisma": "^6.19.0",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.9.3"
